# Flood Rescue Dispatch — backend env (copy to `backend/.env` for local dev).
# Real environment variables always win over `.env` values.
# See `backend/app/config.py` for parsing/defaults.

# Database. Default when empty/unset: sqlite file at backend/data/flood_rescue.db
# (created on demand; no Postgres needed for local dev or tests).
# Postgres (Supabase or local): DATABASE_URL=postgresql://user:password@localhost:5432/flood_rescue
# In-memory (tests/ephemeral):  DATABASE_URL=:memory:
DATABASE_URL=

# Default simulation seed when the request AND the scenario file omit one.
# (Scenario files ship `random_seed`, so this is a last-resort fallback.)
SIM_SEED=42

# API server bind for `py -m backend.app.main` (uvicorn CLI flags override these).
HOST=127.0.0.1
PORT=8000

# Comma-separated CORS origins for the dashboard. Defaults cover local Next.js dev.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Snapshot cadence (ticks) for new simulations created via the API.
SNAPSHOT_EVERY=10
